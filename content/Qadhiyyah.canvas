	"nodes":[
		{
			"id":"6de350ef53e944d2",
			"styleAttributes":{},
			"text":"أقسام",
			"type":"text",
			"x":-385,
			"y":0,
			"width":125,
			"height":60
		},
		{
			"id":"5c53021f2a34533b",
			"styleAttributes":{},
			"text":"الشرطية",
			"type":"text",
			"x":-322,
			"y":139,
			"width":125,
			"height":59
		},
		{
			"id":"519c94ccc1da7524",
			"styleAttributes":{},
			"text":"أقسام",
			"type":"text",
			"x":-259,
			"y":247,
			"width":125,
			"height":60
		},
		{
			"id":"670e20fe4a29857a",
			"styleAttributes":{},
			"text":"**منفصلة** : ما أوجبت التنافر بين المقدم والتالي، مثل العدد إما زوج وإما فرد",
			"type":"text",
			"x":-119,
			"y":405,
			"width":361,
			"height":134
		},
		{
			"id":"26ac9178d54e99b4",
			"styleAttributes":{},
			"text":"**مانعة خلو** وهي ما دلت على امتناع الخلو من طرفيها، وإن جوزت الاجتماع؛ \nمثل: زيد إما في البحر، وإما أن لا يغرق",
			"type":"text",
			"x":-119,
			"y":627,
			"width":361,
			"height":134
		},
		{
			"id":"a2d4145f8ccc964f",
			"styleAttributes":{},
			"text":"**ومانعة جمع وخلو** وهي ما دلت على امتناع الجمع والخلو؛ \nمثل: العدد إما زوج أو فرد",
			"type":"text",
			"x":274,
			"y":627,
			"width":361,
			"height":134
		},
		{
			"id":"67d8142a2887d957",
			"styleAttributes":{},
			"text":"**متصلة** : ما أوجبت التلازم بين المقدم والتالي ، بأن يكون أحدهما لازما للآخر، مثل إن كانت الشمس طالعة، فالنهار موجود",
			"type":"text",
			"x":-524,
			"y":405,
			"width":360,
			"height":134
		},
		{
			"id":"c69523cee3c8bc59",
			"styleAttributes":{},
			"text":"**مانعة جمع:** وهي ماد ما دلت على عدم صحة الاجتماع بين المقدم والتالي، وإن جوزت الخلو.\n مثل: الجسم إما أبيض وإما أسود",
			"type":"text",
			"x":-501,
			"y":627,
			"width":359,
			"height":134
		},
		{
			"id":"c6f93da0ac2ea8db",
			"styleAttributes":{},
			"text":"الحملية",
			"type":"text",
			"x":-578,
			"y":0,
			"width":125,
			"height":60
		},
		{
			"id":"e1a8e1652dd85aa0",
			"styleAttributes":{},
			"text":"تعريف",
			"type":"text",
			"x":-784,
			"y":0,
			"width":125,
			"height":60
		},
		{
			"id":"cdf2db1d69394765",
			"styleAttributes":{},
			"text":"ما اشتملت على موضوع ومحمول ؛ كزيد كاتب",
			"type":"text",
			"x":-1120,
			"y":-8,
			"width":287,
			"height":77
		},
		{
			"id":"654575bfec5b3e6d",
			"styleAttributes":{},
			"text":"أقسام",
			"type":"text",
			"x":-784,
			"y":138,
			"width":125,
			"height":60
		},
		{
			"id":"72a03b1c6d3dc3af",
			"styleAttributes":{},
			"text":"شخصية: إن كان موضوعها جزئيا؛ كزيد كاتب",
			"type":"text",
			"x":-1120,
			"y":100,
			"width":287,
			"height":77
		},
		{
			"id":"bb6136155db4b5fe",
			"styleAttributes":{},
			"text":"مهملة: إن كان كليا، ولم تُسَوَّر؛ كالإنسان حيوان.",
			"type":"text",
			"x":-1120,
			"y":208,
			"width":287,
			"height":77
		},
		{
			"id":"174eef7964afc1b1",
			"styleAttributes":{},
			"text":"كلية بأن سورت بالسور الكلي؛ ككل إنسان حيوان.",
			"type":"text",
			"x":-1120,
			"y":328,
			"width":287,
			"height":77
		},
		{
			"id":"da7faf5b7e240bf5",
			"styleAttributes":{},
			"text":"جزئية: إن سورت بالسور الجزئي؛ كبعض الإنسان حيوان",
			"type":"text",
			"x":-1120,
			"y":448,
			"width":287,
			"height":77
		},
		{
			"id":"b06b35b0ea1bfe3c",
			"styleAttributes":{},
			"text":"موجبة / سالبة",
			"type":"text",
			"x":-1420,
			"y":285,
			"width":250,
			"height":60
		},
		{
			"id":"2c26d991449b3097",
			"styleAttributes":{},
			"text":"مركب احتمل الصدق والكذب لذاته.",
			"type":"text",
			"x":-785,
			"y":-99,
			"width":332,
			"height":60
		},
		{
			"id":"d5b1080461c83e41",
			"styleAttributes":{},
			"text":"تعريف",
			"type":"text",
			"x":-386,
			"y":-99,
			"width":125,
			"height":60
		},
		{
			"id":"6a2037f168c2413c",
			"styleAttributes":{},
			"text":"# القضايا",
			"type":"text",
			"x":-196,
			"y":-43,
			"width":181,
			"height":71
		},
		{
			"id":"a9b80b86889b6ac5",
			"styleAttributes":{},
			"text":"ما تركبت من جزأين، ربط أحدهما بالآخر بأداة شرط، أو عناد.",
			"type":"text",
			"x":-765,
			"y":241,
