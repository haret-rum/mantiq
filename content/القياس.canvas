	},
	"nodes":[
		{
			"id":"efbe27ddcebb7b80",
			"styleAttributes":{"textAlign":"center"},
			"text":"# القياس",
			"type":"text",
			"x":-250,
			"y":-49,
			"width":250,
			"height":90,
			"color":"6"
		},
		{
			"id":"d98fa71f4cdda4d2",
			"styleAttributes":{},
			"text":"الإتيان بوصف جامع بين طرفي المطلوب",
			"type":"text",
			"x":315,
			"y":-490,
			"width":250,
			"height":60
		},
		{
			"id":"4aa041b95e705d5f",
			"styleAttributes":{},
			"text":"ألا يكون أحد حدود القياس مشتركة لفظيا مستعملا في إحدى قضايا القياس",
			"type":"text",
			"x":-863,
			"y":-95,
			"width":250,
			"height":125
		},
		{
			"id":"d32419eb8d1708f7",
			"styleAttributes":{},
			"text":"أن يفيد الحد الأوسط الاستغراق في إحدى المقدمتين على الأقل",
			"type":"text",
			"x":-863,
			"y":46,
			"width":250,
			"height":101
		},
		{
			"id":"70975510d43f24ef",
			"styleAttributes":{},
			"text":"ألا يفيد أحد حدود القياس الاستغراق في النتيجة إلا إذا أفاد ذلك في مقدمته",
			"type":"text",
			"x":-863,
			"y":163,
			"width":250,
			"height":105
		},
		{
			"id":"3c8648d9907394f8",
			"styleAttributes":{},
			"text":"لا إنتاج بين مقدمتين ساليتين وبين جزئيتين",
			"type":"text",
			"x":-863,
			"y":284,
			"width":250,
			"height":102
		},
		{
			"id":"c5f91da6683758d4",
			"styleAttributes":{},
			"text":"إذا كانت إحدى المقدمتين سالبة كانت النتيجة سالبة واذا كانت إحدى المقدمتين جزئية كانت النتيجة جزئية",
			"type":"text",
			"x":-863,
			"y":400,
			"width":250,
			"height":125
		},
		{
			"id":"8345e5b91ef5230e",
			"styleAttributes":{},
			"text":"**شرطي**\nما دل على النتيجة بالفعل، أي: ذكرت فيه النتيجة بمادتها وصورتها",
			"type":"text",
			"x":-5,
			"y":64,
			"width":250,
			"height":125,
			"color":"1"
		},
		{
			"id":"50405788b8237995",
			"styleAttributes":{},
			"text":"**متصل**\nما ركب من القضايا المتصلة نحو لو كان هذا إنساناً لكان حيوانا، لكنه إنسان ينتج فهو حيوان، فاستثناء عين المقدم، وهو إنسان، ينتج عين التالي؛ وهو حيوان",
			"type":"text",
			"x":-42,
			"y":305,
			"width":250,
			"height":244,
			"color":"2"
		},
		{
			"id":"d0ddf71ccd1bf30c",
			"styleAttributes":{},
			"text":"**منفصل**\nا ركب من القضايا المنفصلة، نحو قولك: العدد إما زوج أو فرد، لكنه زوج، ينتج أنه ليس بفرد، ولكنه فرد، ينتج : أنه ليس يزوج",
			"type":"text",
			"x":248,
			"y":305,
			"width":250,
			"height":206,
			"color":"2"
		},
		{
			"id":"75d4f845bd0ba5c8",
			"styleAttributes":{},
			"text":"تمييز الصحيح من الفاسد ، لأن النتيجة لازم، واللازم بحسب ملزومه، إن صحيحًا فصحيح، وإن فاسدًا ففاسد، فالنتيجة صحيحة إن كان كل من المقدمتين صحيحًا، وإلا ففاسدة.",
			"type":"text",
			"x":315,
			"y":-390,
			"width":250,
			"height":225
		},
		{
			"id":"d8a0548d505dd16a",
			"styleAttributes":{},
			"text":"ترتيب المقدمات - جمع مقدمة، أي: القضية - التي جعلت جزء دليل - سميت بذلك : لتقدمها على المطلوب ، فإن لم تكن جزء دليل فلا تسمى مقدمة، بأن تقدم المقدمة الصغرى على الكبرى",
			"type":"text",
			"x":315,
			"y":-125,
			"width":250,
			"height":241
		},
		{
			"id":"77cf7c1a21534aed",
			"styleAttributes":{},
			"text":"اندراج المقدمة الصغرى في الكبرى",
			"type":"text",
			"x":315,
			"y":156,
			"width":250,
			"height":60
		},
		{
			"id":"7d432f9a8d8ee8a2",
			"styleAttributes":{},
			"text":"الحملية والشرطية",
			"type":"text",
			"x":-714,
			"y":-687,
			"width":170,
			"height":60
		},
		{
			"id":"bbcd1b07e9748991",
			"styleAttributes":{},
			"text":"الشرطيات",
			"type":"text",
			"x":-504,
			"y":-687,
			"width":170,
			"height":60
		},
		{
			"id":"9c7c758218ba997c",
			"styleAttributes":{},
			"text":"الحمليات",
			"type":"text",
			"x":-294,
			"y":-687,
			"width":170,
			"height":60
		},
		{
			"id":"fd79b94d0f119121",
			"styleAttributes":{},
			"text":"البسيط: لفظ تركب من قضيتين فقط يلزم عنهما لذاتها قول آخر\nمثال: العالم متغير، وكل متغير حادث، يلزم عنه: العالم حادث",
			"type":"text",
			"x":-933,
			"y":-515,
			"width":320,
			"height":140
		},
		{
			"id":"2581356a3f7921e5",
			"styleAttributes":{},
			"text":"المركب: لفظ تركب من أكثر من قضية يلزم عنها لذاتها قول آخر\nمثال: النباش آخذ للمال خفية، وكل آخذ للمال خفية سارق، وكل سارق تقطع يده، يلزم عنه: النباش تقطع يده",
			"type":"text",
			"x":-933,
			"y":-335,
			"width":320,
			"height":196
		},
		{
			"id":"df22d263928d2773",
			"styleAttributes":{},
			"text":"**المكونات**",
			"type":"text",
			"x":-77,
			"y":-460,
			"width":120,
			"height":60,
			"color":"2"
		},
		{
			"id":"ede5b2cd33c81d02",
			"styleAttributes":{},
			"text":"التقسيم باعتبار نوع القضية",
			"type":"text",
			"x":-374,
			"y":-515,
			"width":250,
			"height":50,
			"color":"2"
		},
		{
			"id":"d1a1f8beb6ca694d",
			"styleAttributes":{},
			"text":"التقسيم باعتبار التركيب",
			"type":"text",
			"x":-525,
			"y":-430,
			"width":250,
			"height":60,
			"color":"2"
		},
		{
			"id":"a0915f978c29ea67",
			"styleAttributes":{},
			"text":"**لغة**: تقدير شيء على مثال شيء آخر",
			"type":"text",
			"x":-297,
			"y":206,
			"width":240,
			"height":60
		},
		{
			"id":"20e786efa265c9c4",
			"styleAttributes":{},
			"text":"**التريف**",
			"type":"text",
			"x":-311,
			"y":87,
			"width":125,
			"height":60,
			"color":"1"
		},
		{
			"id":"bd8bf846847bc33c",
			"styleAttributes":{},
			"text":"**اصطلاحا**: لفظ تركب من قضيتين فأكثر يلزم عنهما لذاتهما قول آخر",
			"type":"text",
			"x":-539,
			"y":206,
			"width":228,
			"height":119
		},
		{
			"id":"675ca0b8f9e25cc2",
			"styleAttributes":{"border":"dashed"},
			"text":"ويسمى بالشرط لاشتمال القضية الأولى المسماة بالكبرى على الشرط؛ إن كانت الشمس طالعة فالنهار موجودا، لكن الشمس طالعة، فينتج النهار موجود، وهذه النتيجة ذكرت في القياس",
			"type":"text",
			"x":-307,
			"y":330,
			"width":250,
			"height":193,
			"color":"5"
		},
		{
			"id":"f0929e1531af9564",
			"styleAttributes":{"border":"dashed"},
			"text":"من جهة النظم، بأن كانتا ساليتين أو جزئيتين، إذ لا إنتاج السالبنين أو جزئيتين. ومن جهة المادة بأن كانتا كاذبتين أو إحداهما كاذبة",
			"type":"text",
			"x":620,
			"y":-361,
			"width":230,
			"height":167,
			"color":"5"
		},
		{
			"id":"3b5f44d86f835165",
			"styleAttributes":{},
			"text":"**اقتراني**\nما دل على النتيجة بالقوة، أي بالمعنى، بأن تكون النتيجة مذكورة فيه بمادتها، لا بصورتها.\n**مثال** العالم متغير، وكل متغير حادث، يلزم عنه: العالم حادث",
			"type":"text",
			"x":-250,
			"y":-290,
			"width":250,
			"height":220,
			"color":"1"
		},
		{
			"id":"2d40d0d476f5b6e0",
			"styleAttributes":{},
			"text":"**القاعدة**",
			"type":"text",
			"x":0,
			"y":-370,
			"width":125,
			"height":50,
			"color":"2"
		},
		{
			"id":"f0b708fedffb7c3b",
			"styleAttributes":{},
			"text":"**الشروط**",
			"type":"text",
			"x":-436,
			"y":-260,
			"width":125,
			"height":50,
			"color":"2"
		},
		{
			"id":"6a9ad7e80a237071",
			"styleAttributes":{},
			"text":"المقدمة الصغرى: المشتملة على الحد الأصغر ، الذي هو موضوع النتيجة",
			"type":"text",
			"x":458,
			"y":-734,
			"width":250,
			"height":123
		},
		{
			"id":"1b9b84bc5d2b2673",
			"styleAttributes":{},
			"text":"النتيجة: الحاصل المطلوب يتكون من الحد الأصغر والحد الأكبر",
			"type":"text",
			"x":-82,
			"y":-734,
			"width":250,
			"height":123
		},
		{
			"id":"5c214618a92c3b40",
			"styleAttributes":{},
			"text":"المقدمة الكبرى المشتملة على الحد الأكبر، الذي هو محمول النتيجة",
			"type":"text",
			"x":188,
			"y":-734,
			"width":250,
			"height":123
		},
		{
			"id":"01bf33f6a342722b",
			"styleAttributes":{"border":"dashed"},
			"text":"سمي موضوع النتيجة أصغر : لأنه أقل أفرادا غالبًا من محمولها الذي سمي أكبر : لكثرة أفراده، وسمي كل منهما حدا لأنه طرف القضية",
			"type":"text",
			"x":-89,
			"y":-840,
			"width":515,
			"height":88,
			"color":"5"
		}
	]
}